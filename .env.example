# Better Call Ron — environment template
# Copy this file to .env and fill in the placeholders. .env is gitignored.

AGENTPHONE_API_KEY=
AGENTPHONE_WEBHOOK_SECRET=
AGENTPHONE_AGENT_ID=
AGENTPHONE_INBOUND_NUMBER=

# Optional. Pin outbound SMS/iMessage to a specific attached number (number_id,
# NOT phone). Useful when one of your agent's numbers is iMessage-capable and
# you want all outbound to go through it. Leave empty to let AgentPhone pick.
AGENTPHONE_MESSAGING_NUMBER_ID=

# AgentMail — emails the matched lawyer their brief on connect.
# AGENTMAIL_INBOX_ID is optional: if unset, an inbox is created on first send
# and the id is logged so you can paste it back here to reuse across restarts.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Browser Use Cloud — powers research_and_email for self-serve informational
# requests. When unset, the tool falls back to a static curated resource pack.
BROWSER_USE_API_KEY=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

DISPATCHER_PHONE=
PUBLIC_DEFENDER_HOTLINE=

WEBHOOK_PUBLIC_URL=
